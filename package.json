{
  "name": "watchparty-server",
  "version": "1.0.0",
  "description": "WebSocket server for WatchParty — a watch-together app for Stremio",
  "main": "dist/index.js",
  "scripts": {
    "start": "npm run build && node --env-file-if-exists=.env .",
    "serve": "tsc-watch --onSuccess \"node --env-file-if-exists=.env .\"",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "MertD95 (originally by tymmesyde)",
  "license": "ISC",
  "dependencies": {
    "pino": "^10.3.1",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
