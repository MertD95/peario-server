# Server port
PORT=8181

# TLS (optional — omit both to run plain HTTP/WS, e.g. behind a reverse proxy)
# PEM_CERT=./cert/localhost.crt
# PEM_KEY=./cert/localhost.key

# Room cleanup interval (ms)
INTERVAL_ROOM_UPDATE=30000

# WebSocket ping/pong interval (ms)
PING_INTERVAL=30000

# Connection limits
MAX_CONNECTIONS=10000
MAX_CONNECTIONS_PER_IP=10

# Logging
LOG_LEVEL=info
NODE_ENV=development
